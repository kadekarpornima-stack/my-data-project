   "source": [
    "import os\n",
    "import glob\n",
    "import requests\n",
    "import pandas as pd\n",
    "\n",
    "# Define path to raw files directory\n",
    "folder_path = os.path.join('data', 'raw')\n",
    "\n",
    "# =====================================================================\n",
    "# TASK 1: LOAD & INSPECT ALL LOCAL CSV FILES\n",
    "# =====================================================================\n",
    "print(\"==================================================\")\n",
    "print(\"      TASK 1: INSPECTING THE LOCAL DATASETS       \")\n",
    "print(\"==================================================\\n\")\n",
    "\n",
    "# Grab all available CSV files, ignoring previous live data downloads\n",
    "csv_files = sorted(glob.glob(os.path.join(folder_path, '*.csv')))\n",
    "csv_files = [f for f in csv_files if \"live_nav\" not in os.path.basename(f)]\n",
    "\n",
    "print(f\"🔍 Found {len(csv_files)} baseline datasets to inspect.\\n\")\n",
    "\n",
    "for i, file_path in enumerate(csv_files, 1):\n",
    "    file_name = os.path.basename(file_path)\n",
    "    print(\"=\" * 60)\n",
    "    print(f\"📄 DATASET {i}: {file_name}\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    try:\n",
    "        df = pd.read_csv(file_path)\n",
    "        \n",
    "        print(f\"1. SHAPE (Rows, Columns): {df.shape}\")\n",
    "        print(\"\\n2. DATA TYPES (.dtypes):\")\n",
    "        print(df.dtypes)\n",
    "        print(\"-\" * 40)\n",
    "        print(\"3. DATA PREVIEW (.head()):\")\n",
    "        display(df.head(5))\n",
    "        \n",
    "        # Scan for Missing Values / Duplicates\n",
    "        missing_values = df.isnull().sum().sum()\n",
    "        duplicate_rows = df.duplicated().sum()\n",
    "        \n",
    "        if missing_values > 0 or duplicate_rows > 0:\n",
    "            print(\"\\n⚠️ POTENTIAL ANOMALIES DETECTED:\")\n",
    "            if missing_values > 0:\n",
    "                print(f\"   - Found {missing_values} missing (NaN) values.\")\n",
    "                if \"sip_inflows\" in file_name:\n",
    "                    print(\"     👉 Note: Missing values are the first 12 rows of 'yoy_growth_pct' due to missing 2021 baseline math.\")\n",
    "            if duplicate_rows > 0:\n",
    "                print(f\"   - Found {duplicate_rows} duplicate rows.\")\n",
    "        else:\n",
    "            print(\"\\n✅ Structure looks clean! No missing data or duplicates.\")\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error loading {file_name}: {e}\")\n",
    "    print(\"\\n\\n\")\n",
    "\n",
    "\n",
    "# =====================================================================\n",
    "# TASK 2: FETCH LIVE NAV FROM API & SAVE AS RAW CSV\n",
    "# =====================================================================\n",
    "print(\"==================================================\")\n",
    "print(\"      TASK 2: FETCHING LIVE NAV FROM API         \")\n",
    "print(\"==================================================\\n\")\n",
    "\n",
    "scheme_id = \"125497\"  # HDFC Top 100 Direct Plan\n",
    "api_url = f\"https://api.mfapi.in/mf/{scheme_id}\"\n",
    "\n",
    "print(f\"📡 Requesting real-time records from: {api_url}\")\n",
    "\n",
    "try:\n",
    "    # 1. Fetch live JSON payload from API\n",
    "    response = requests.get(api_url, timeout=15)\n",
    "    response.raise_for_status()\n",
    "    \n",
    "    json_payload = response.json()\n",
    "    metadata = json_payload.get('meta', {})\n",
    "    historical_nav_data = json_payload.get('data', [])\n",
    "    \n",
    "    fund_name = metadata.get('scheme_name', 'HDFC Mutual Fund')\n",
    "    print(f\"✅ Success! Connected to API for: {fund_name}\")\n",
    "    print(f\"📊 Retrieved {len(historical_nav_data)} total timeline entries.\")\n",
    "    \n",
    "    # 2. Transform into a Pandas DataFrame\n",
    "    df_live = pd.DataFrame(historical_nav_data)\n",
    "    df_live['nav'] = pd.to_numeric(df_live['nav'])\n",
    "    df_live['date'] = pd.to_datetime(df_live['date'], format='%d-%m-%Y')\n",
    "    df_live = df_live.sort_values('date').reset_index(drop=True)\n",
    "    \n",
    "    # 3. Save directly to your data/raw folder\n",
    "    output_filename = os.path.join(folder_path, f\"{scheme_id}_live_nav.csv\")\n",
    "    df_live.to_csv(output_filename, index=False)\n",
    "    print(f\"💾 File safely saved to: {output_filename}\")\n",
    "    \n",
    "    print(f\"\\n📊 Live NAV Dataset Final Shape: {df_live.shape}\")\n",
    "    print(\"\\n📈 Top 5 rows of newly fetched data (.head()):\")\n",
    "    display(df_live.head(5))\n",
    "\n",
    "except Exception as err:\n",
    "    print(f\"❌ API data processing sequence failed: {err}\")"
   ]
  },
